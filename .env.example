# Required for the investigation agent (not needed for `extract` / `enrich`).
ANTHROPIC_API_KEY=

# Optional enrichment keys. Every source without a key is skipped and noted
# as a gap in the report; keyless sources (RDAP, DNS, Shodan InternetDB,
# NVD, CISA KEV, OTX general lookups) always run.
VT_API_KEY=            # VirusTotal  https://www.virustotal.com/gui/my-apikey
ABUSEIPDB_API_KEY=     # AbuseIPDB   https://www.abuseipdb.com/account/api
OTX_API_KEY=           # AlienVault OTX (optional, raises rate limits)
ABUSECH_AUTH_KEY=      # abuse.ch ThreatFox / URLhaus / MalwareBazaar  https://auth.abuse.ch/
NVD_API_KEY=           # NVD (optional, raises rate limits)

# Optional overrides
CTI_AGENT_MODEL=claude-opus-5-5
CTI_AGENT_EFFORT=high
